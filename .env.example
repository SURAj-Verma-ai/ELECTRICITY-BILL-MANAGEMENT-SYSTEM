# Environment Configuration Template
# Copy this to .env and fill in actual values

# Application Settings
APP_NAME=EBMS
APP_ENV=development
APP_DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
# APP_ENV=development -> SQLite (database/ebms_dev.db), no setup needed
# APP_ENV=production  -> MySQL, using the DB_* settings below
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ebms_db
DB_USER=ebms_user
DB_PASSWORD=secure_password

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=3600

# Email Service
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=noreply@ebms.local

# Third-party Services
PAYMENT_GATEWAY_KEY=your-key-here
NOTIFICATION_SERVICE_URL=http://notification-service:8001
